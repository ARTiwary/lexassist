# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Set to "true" (default) to call the real Groq API; "false" uses a
# deterministic offline mock client for local development without a key.
# The automated test suite always uses the mock regardless of this
# setting (injected via a FastAPI dependency override).
USE_LIVE_LLM=true

# Required when USE_LIVE_LLM=true. Get a free key at
# https://console.groq.com/keys
GROQ_API_KEY=

# Groq model to use. openai/gpt-oss-120b is Groq's current recommended
# general-purpose flagship model as of Sept 2026. Other options include
# openai/gpt-oss-20b (smaller/faster) and qwen/qwen3.6-27b.
# Check https://console.groq.com/docs/models for the current list.
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of origins allowed to call the API (CORS).
# Includes both localhost and 127.0.0.1 by default -- browsers treat these
# as different origins even on the same machine, so both are needed for
# local development regardless of which one you type in the address bar.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Max upload size in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760

# Requests allowed per client per minute.
RATE_LIMIT_PER_MINUTE=30
